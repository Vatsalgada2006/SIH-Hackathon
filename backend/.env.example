# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ner_db

# Redis Settings (no password for simplicity in dev)
# REDIS_PASSWORD=your_redis_password

# FastAPI Settings
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# JWT Settings (for development only, use strong secrets in production)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Corridor Settings (Guwahati to Shillong NH6)
CORRIDOR_NAME=Guwahati-Shillong NH6
CORRIDOR_BBOX=88.0,25.0,92.0,27.0  # Example bbox, adjust as needed

# Open-Meteo API (free, no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# GraphHopper Settings (if using Docker, the service will be available at this host)
GRAPHHOPPER_HOST=graphhopper
GRAPHHOPPER_PORT=8989