@pytest.mark.asyncio
async def test_calculate_segment_accessibility_multiple_incidents_precedence(db_session: AsyncSession):
    # Create a road segment
    segment = RoadSegment(
        id=1,
        start_node_id=1,
        end_node_id=2,
        status="UNKNOWN"
    )
    db_session.add(segment)
    await db_session.commit()

    # Create a verified active degrading incident
    incident1 = Incident(
        id=1,
        reporter_id=1,
        description="Test",
        incident_type="LANDSLIDE",
        severity="MEDIUM",
        latitude=0.0,
        longitude=0.0,
        segment_id=1,
        status=IncidentStatus.VERIFIED.value,
        reported_at=datetime.utcnow(),
    )
    # Create a verified active blocking incident
    incident2 = Incident(
        id=2,
        reporter_id=2,
        description="Test2",
        incident_type="FLOOD",
        severity="HIGH",
        latitude=0.0,
        longitude=0.0,
        segment_id=1,
        status=IncidentStatus.VERIFIED.value,
        reported_at=datetime.utcnow(),
    )
    db_session.add_all([incident1, incident2])
    await db_session.commit()

    service = AccessibilityService(db_session)
    status = await service.calculate_segment_accessibility(1)
    assert status == "BLOCKED"  # Blocking takes precedence

@pytest.mark.asyncio
async def test_update_segment_accessibility(db_session: AsyncSession):
    # Create a road segment
    segment = RoadSegment(
        id=1,
        start_node_id=1,
        end_node_id=2,
        status="UNKNOWN"
    )
    db_session.add(segment)
    await db_session.commit()

    # Create a verified active degrading incident
    incident = Incident(
        id=1,
        reporter_id=1,
        description="Test",
        incident_type="LANDSLIDE",
        severity="MEDIUM",
        latitude=0.0,
        longitude=0.0,
        segment_id=1,
        status=IncidentStatus.VERIFIED.value,
        reported_at=datetime.utcnow(),
    )
    db_session.add(incident)
    await db_session.commit()

    service = AccessibilityService(db_session)
    new_status = await service.update_segment_accessibility(1)
    assert new_status == "DEGRADED"

    # Check that the segment status was updated in the database
    from sqlalchemy import select
    result = await db_session.execute(select(RoadSegment.status).where(RoadSegment.id == 1))
    current_status = result.scalar_one()
    assert current_status == "DEGRADED"

