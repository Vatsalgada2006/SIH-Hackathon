# ==============================================================================
# RiskRoute Backend — Environment Configuration
# All services below use FREE tiers. See setup notes at the bottom of this file.
# ==============================================================================

# --- Database (Neon — free PostgreSQL + PostGIS) -----------------------------
# 1. Sign up at https://neon.tech (free tier, no card required)
# 2. Create a project, then run: CREATE EXTENSION postgis;
# 3. Copy the connection string from the Neon dashboard
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# --- Redis (Upstash — free tier, 10k commands/day) ----------------------------
# 1. Sign up at https://upstash.com (free tier, no card required)
# 2. Create a Redis database, copy the connection string (use the redis:// or rediss:// URL)
REDIS_URL=rediss://default:<password>@<upstash-host>:<port>

# --- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<generate-a-random-64-char-hex-string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Routing (self-hosted OSRM, free, no external API key needed) ------------
# Points at the OSRM container defined in docker-compose.yml
ROUTING_ENGINE=osrm
OSRM_BASE_URL=http://osrm:5000

# --- Geocoding (Nominatim, free) ----------------------------------------------
# Public instance is rate-limited to 1 req/sec (fine for hackathon use).
# Self-host later if volume grows — see https://github.com/mediagis/nominatim-docker
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Weather (Open-Meteo, free, no key required) ------------------------------
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- ML Service ----------------------------------------------------------------
# No trained model yet — service runs a rule-based stub until one is trained.
ML_MODEL_PATH=
ML_CONFIDENCE_THRESHOLD=0.7

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# SETUP NOTES
# ==============================================================================
# 1. Neon:      https://neon.tech            → DATABASE_URL
# 2. Upstash:   https://upstash.com          → REDIS_URL
# 3. JWT:       `openssl rand -hex 32`       → JWT_SECRET_KEY
# 4. OSRM:      runs locally via docker-compose, no signup needed
# 5. Nominatim: public free instance, no signup needed (self-host if scaling up)
# 6. Open-Meteo: fully free, no signup, no key needed
#
# Deployment target (also free-tier): Render (https://render.com) — free web
# service tier, sleeps after inactivity but costs nothing.
# ==============================================================================
